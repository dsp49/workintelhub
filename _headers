# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# These replace the (inert) security-header and caching rules in web.config.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprint-free assets — long cache. Bump the filename when an image changes.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

# Stylesheet has no content hash in its name, so keep this short.
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate
